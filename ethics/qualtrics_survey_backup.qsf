nseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"","NextButton":"","SurveyTitle":"Edinburgh Literary Geography \u2014 Visualisation Study","SkinLibrary":"edinburghinformatics","SkinType":"component","Skin":{"brandingId":null,"templateId":"*simple","overrides":null},"NewScoring":1,"SurveyMetaDescription":"A study on how to visualise where Edinburgh's literature is set. Explore six different ways of showing place names from Scottish novels, memoirs and letters across the city \u2014 takes about 50\u201365 minutes. MSc research project, University of Edinburgh (ethics ref. 446635).","EOSMessage":null,"ShowExportTags":"true","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]}}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"How familiar are you with reading data visualisations or charts in general (e.g. bar charts, netw...","TertiaryAttribute":null,"Payload":{"QuestionText":"How familiar are you with reading data visualisations or charts in general (e.g. bar charts, network diagrams, maps)?","DefaultChoices":false,"DataExportTag":"Q-B4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How familiar are you with reading data visualisations or charts in general (e.g. bar charts, netw...","Choices":{"1":{"Display":"Not at all familiar"},"2":{"Display":"Slightly familiar"},"3":{"Display":"Moderately familiar"},"4":{"Display":"Very familiar"},"5":{"Display":"Extremely familiar"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Have you lived in or spent significant time in Edinburgh?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you lived in or spent significant time in Edinburgh?","DefaultChoices":false,"DataExportTag":"Q-B5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have you lived in or spent significant time in Edinburgh?","Choices":{"1":{"Display":"Yes, I live\/have lived there"},"2":{"Display":"I've visited several times"},"3":{"Display":"I've visited once or twice"},"4":{"Display":"Never"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID11"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Part 1: Author Fingerprints Each of the next three visualisations shows five authors' individual...","TertiaryAttribute":null,"Payload":{"QuestionText":"Part 1: Author Fingerprints\n\nEach of the next three visualisations shows five authors' individual \"fingerprints\" \u2014 how each of them distributes place names across Edinburgh in their writing. For each one, you'll first see all five authors' fingerprints together, each labelled with the author's name. Take a few minutes to look at them and get a feel for how each author's pattern differs from the others \u2014 there's no trick to look for, just notice whatever stands out to you.\n\nThen we'll show you one of those five fingerprints again on its own, with the name hidden, and ask which author you think it is, based on the pattern you just looked at. You're welcome to go back and check the labelled view again before answering \u2014 this isn't a memory test.\n\nPlease open each link in a new browser tab, and come back to this page to answer.","DefaultChoices":false,"DataExportTag":"Q-Part1Intro","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Part 1: Author Fingerprints Each of the next three visualisations shows five authors' individual...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID12"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Step 1: Take a few minutes to compare all five authors' fingerprints below. Open reference view \u2192","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"polyglot__panel\" style=\"left: -9px; top: 57px;\">\n<div class=\"polyglot__inner\"><button class=\"polyglot__confirm-button\"><img alt=\"Translate\" src=\"webkit-masked-url:\/\/hidden\/\" \/><\/button><\/div>\n<\/div>\nStep 1: Take a few minutes to compare all five authors&#39; fingerprints below.<br \/>\n<a href=\"https:\/\/merrittw-1307.github.io\/uoe-edinburgh-literary-geovis\/data\/processed\/dir_1\/radar\/d3\/radar.html\" target=\"_blank\">Open reference view &rarr;<\/a>","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-Reference","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Step 1: Take a few minutes to compare all five authors' fingerprints below. Open reference view \u2192","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID13"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Step 2: Now look at one of those five fingerprints again on its own, with the name hidden. The re...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"polyglot__panel\" style=\"left: -16px; top: 77px;\">\n<div class=\"polyglot__inner\"><button class=\"polyglot__confirm-button\"><img alt=\"Translate\" src=\"webkit-masked-url:\/\/hidden\/\" \/><\/button><\/div>\n<\/div>\nStep 2: Now look at one of those five fingerprints again on its own, with the name hidden. The reference view from Step 1 is still open in your other tab if you want to check it again.<br \/>\n<a href=\"https:\/\/merrittw-1307.github.io\/uoe-edinburgh-literary-geovis\/ethics\/study_stimuli\/radar_task.html\" target=\"_blank\">Open this one &rarr;<\/a>","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-Blind","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Step 2: Now look at one of those five fingerprints again on its own, with the name hidden. The re...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Based on the chart shown above (not your memory of the earlier reference view), which sector does...","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on the chart shown above (not your memory of the earlier reference view), which sector does this author's writing concentrate on the most?","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-F0","QuestionType":"MC","Selector":"SAVR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","NumColumns":2},"QuestionDescription":"Based on the chart shown above (not your memory of the earlier reference view), which sector does...","Choices":{"1":{"Display":"Old Town"},"2":{"Display":"Canongate"},"3":{"Display":"Leith"},"4":{"Display":"Liberton\/Gilmerton"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID15","SubSelector":"TX","Randomization":{"Advanced":null,"Type":"ScaleReversal","ConsistentScaleReversal":true,"TotalRandSubset":""}}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Which of the following five authors do you think this represents?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the following five authors do you think this represents?","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-F1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the following five authors do you think this represents?","Choices":{"1":{"Display":"Alexander McCall Smith"},"2":{"Display":"Irvine Welsh"},"3":{"Display":"John Gibson Lockhart"},"4":{"Display":"Walter Scott"},"5":{"Display":"Robert Louis Stevenson"},"6":{"Display":"I don't know"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID16"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"If your first guess turned out to be wrong, which of the five would be your second guess?","TertiaryAttribute":null,"Payload":{"QuestionText":"If your first guess turned out to be wrong, which of the five would be your second guess?","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-F1b","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If your first guess turned out to be wrong, which of the five would be your second guess?","Choices":{"1":{"Display":"Alexander McCall Smith"},"2":{"Display":"Irvine Welsh"},"3":{"Display":"John Gibson Lockhart"},"4":{"Display":"Walter Scott"},"5":{"Display":"Robert Louis Stevenson"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"How confident are you in this answer?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in this answer?","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-F2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How confident are you in this answer?","Choices":{"1":{"Display":"Not at all confident"},"2":{"Display":"Slightly confident"},"3":{"Display":"Moderately confident"},"4":{"Display":"Confident"},"5":{"Display":"Very confident"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID18"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"What specific feature of the shape led you to that answer? (for example, an unusually large spike...","TertiaryAttribute":null,"Payload":{"QuestionText":"What specific feature of the shape led you to that answer? (for example, an unusually large spike in one area, or a shape that's spread evenly across many areas)","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-F3","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What specific feature of the shape led you to that answer? (for example, an unusually large spike...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID19"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Welcome Thank you for considering taking part in this study about visualising Edinburgh's literar...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"polyglot__panel\" style=\"left: 326px; top: 57px;\">\n<div class=\"polyglot__inner\"><button class=\"polyglot__confirm-button\"><img alt=\"Translate\"><\/button><\/div>\n<\/div>\nWelcome Thank you for considering taking part in this study about visualising Edinburgh's literary geography. Before you begin, please read the Participant Information Sheet:&nbsp;<a target=\"_blank\" href=\"https:\/\/merrittw-1307.github.io\/uoe-edinburgh-literary-geovis\/dissertation\/5Aug\/pis.pdf\" rel=\"noopener\">Participant Information Sheet<\/a><br>This should take about 50\u201365 minutes. There are no right or wrong answers \u2014 we're interested in your honest first impressions.\n\nThis project has ethics approval from the Informatics Research Ethics Committee (reference 446635).<br>","DefaultChoices":false,"DataExportTag":"Q-Welcome","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome Thank you for considering taking part in this study about visualising Edinburgh's literar...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID2"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"If no one had told you anything about this visualisation, would you have understood how to read i...","TertiaryAttribute":null,"Payload":{"QuestionText":"If no one had told you anything about this visualisation, would you have understood how to read it just by looking?","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-F4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If no one had told you anything about this visualisation, would you have understood how to read i...","Choices":{"1":{"Display":"Yes, easily"},"2":{"Display":"Yes, with a little effort"},"3":{"Display":"No, I was confused about how to read it"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID20"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Step 3: Here are all five patterns again, without any names, in a new random order. Try to match...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"polyglot__panel\" style=\"left: 3px; top: 77px;\">\n<div class=\"polyglot__inner\"><button class=\"polyglot__confirm-button\"><img alt=\"Translate\" src=\"webkit-masked-url:\/\/hidden\/\" \/><\/button><\/div>\n<\/div>\nStep 3: Here are all five patterns again, without any names, in a new random order. Try to match each one to an author, using what you learned from the reference view.<br \/>\n<a href=\"https:\/\/merrittw-1307.github.io\/uoe-edinburgh-literary-geovis\/ethics\/study_stimuli\/radar_matching.html\" target=\"_blank\">Open matching view &rarr;<\/a>","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-Matching","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Step 3: Here are all five patterns again, without any names, in a new random order. Try to match...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID21"}},{"SurveyID":"SV_7aeeccWeLrO2j7U","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"Match each of the following to an author.","TertiaryAttribute":null,"Payload":{"QuestionText":"Match each of the following to an author.","DefaultChoices":false,"DataExportTag":"Q-FP-Radar-M1","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false